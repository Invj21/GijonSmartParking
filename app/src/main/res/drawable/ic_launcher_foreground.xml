<?xml version="1.0" encoding="utf-8"?>
<!-- Primo piano dell'icona adattiva: monogramma "P" (parcheggio) in oro (asturias_gold),
     stesso oro della Cruz de la Victoria usato per i pulsanti nell'app. Disegnata come
     forma geometrica (asta + anello) invece di un font, così resta nitida a ogni densità
     e funziona anche come icona monocromatica (Android 13+, tema dinamico). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Asta verticale della "P" -->
    <path
        android:fillColor="#EEB700"
        android:pathData="M39,32 L53,32 L53,82 L39,82 Z" />
    <!-- Anello superiore della "P": cerchio pieno con un foro (evenOdd) -->
    <path
        android:fillColor="#EEB700"
        android:fillType="evenOdd"
        android:pathData="M40,42 A17,17 0 1,0 74,42 A17,17 0 1,0 40,42 Z
                           M51.5,42 A7.5,7.5 0 1,0 66.5,42 A7.5,7.5 0 1,0 51.5,42 Z" />
</vector>
